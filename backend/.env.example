# Local backend configuration. Copy to backend/.env.
# For Render production variables, use .env.render.example.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsa_mcq_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/dsa_mcq_db
# Supabase: use Connect > Transaction pooler for DATABASE_URL (port 6543).
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Use Connect > Direct connection or Session pooler (port 5432) for migrations.
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ENVIRONMENT=development
EXAM_TIMEZONE=Asia/Kolkata
FRONTEND_URL=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
