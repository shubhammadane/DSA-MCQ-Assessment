# Render -> Web Service -> Environment -> Add from .env.
# Fill this template with values from backend/.env and your deployed domains.
# These values belong only on Render, never in Vercel's frontend variables.
PYTHON_VERSION=3.14.8
ENVIRONMENT=production

# Supabase Connect -> Transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Supabase Connect -> Session pooler (port 5432).
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Reuse your existing persistent SECRET_KEY from backend/.env.
SECRET_KEY=copy-your-existing-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_USERNAME=admin
ADMIN_PASSWORD=set-a-unique-production-admin-password

# Exact Vercel origin, without a trailing slash or URL path.
# Multiple origins can be separated by commas.
FRONTEND_URL=https://your-frontend.vercel.app
EXAM_TIMEZONE=Asia/Kolkata
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
